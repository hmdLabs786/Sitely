# ==============================================================================
# Sitely Digital Studio — Environment Variables Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' or '.env.local':
#      cp .env.example .env.local
# 2. Replace all placeholder values with your real development/production credentials.
# 3. NEVER commit '.env' or any file containing real credentials to version control.
# 4. Verify that no secret keys are prefixed with 'NEXT_PUBLIC_' or 'REACT_APP_'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8000
APP_URL=https://sitely.pk

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC VARIABLES (Safe for Browser Exposure)
# ------------------------------------------------------------------------------
# NOTE: Any variable prefixed with 'NEXT_PUBLIC_' or 'REACT_APP_' is bundled into
# the client-side JavaScript and is visible to anyone inspecting network traffic!
# Only public, client-safe keys belong here.

# Canonical public website URL
NEXT_PUBLIC_APP_URL=https://sitely.pk

# Supabase Public Configuration
# IMPORTANT: The anon key is ONLY safe in client-side code IF Row Level Security (RLS)
# is actively enabled on EVERY table in your database. Without RLS, the anon key grants
# full read/write access to your database!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Stripe Public Key (For client-side checkout forms and Stripe.js)
# MUST begin with pk_test_ (development) or pk_live_ (production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE SECRETS (STRICTLY CONFIDENTIAL — NEVER EXPOSE CLIENT-SIDE)
# ------------------------------------------------------------------------------
# CAUTION: Never prefix these variables with NEXT_PUBLIC_ or REACT_APP_.
# These must ONLY be accessed in server environments (Node.js, serverless functions, API routes).

# Supabase Admin / Service Role Key
# DANGER: The service role key bypasses Row Level Security (RLS) completely.
# It grants unrestricted root admin access to your database. NEVER expose to browser!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Stripe Secret Keys (For server-side charge creation and webhook validation)
# MUST begin with sk_test_ or sk_live_
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# Database Connection Strings (PostgreSQL / MongoDB)
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/sitely_db?sslmode=require
MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/sitely_db?retryWrites=true&w=majority

# Authentication & Session Secrets
JWT_SECRET=your_super_strong_random_jwt_signing_secret_here
OAUTH_CLIENT_ID=your_oauth_client_id_here
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Email Services (SendGrid / Resend)
SENDGRID_API_KEY=SG.placeholder_sendgrid_api_key_here
CONTACT_NOTIFICATION_EMAIL=sitelydigitalstudio@gmail.com

# SMS & WhatsApp Communications (Twilio)
TWILIO_ACCOUNT_SID=AC_placeholder_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AI & Language Model Services
OPENAI_API_KEY=sk-placeholder_openai_api_key_here

# Cloud Storage & Infrastructure (AWS S3)
AWS_ACCESS_KEY_ID=AKIA_placeholder_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sitely-assets-storage
